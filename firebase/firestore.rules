rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function chat(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }
    function isMember(chatId) {
      return signedIn() && request.auth.uid in chat(chatId).memberIds;
    }
    function validProfile(data) {
      return data.uid == request.auth.uid
        && data.email is string
        && data.displayName is string
        && data.displayName.size() <= 60
        && data.bio is string
        && data.bio.size() <= 200
        && (
          (data.profileComplete == false && data.username == "" && data.usernameLower == "")
          || (
            data.profileComplete == true
            && data.username.size() >= 3
            && data.username.size() <= 20
            && data.usernameLower == data.username.lower()
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && validProfile(request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && validProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /blocked/{otherId} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId);
      }
      match /tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
      match /readCursors/{chatId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && name.size() >= 3;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /chats/{chatId} {
      allow read: if isMember(chatId);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(chatId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.type == resource.data.type
        && (
          request.resource.data.memberIds == resource.data.memberIds
          || (
            request.auth.uid in resource.data.adminIds
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          )
          || (
            resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          )
        );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read: if isMember(chatId);
        allow create, update: if isMember(chatId) && (memberId == request.auth.uid || request.auth.uid in chat(chatId).adminIds);
        allow delete: if memberId == request.auth.uid || (isMember(chatId) && request.auth.uid in chat(chatId).adminIds);
      }

      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (!('fileSize' in request.resource.data) || request.resource.data.fileSize <= 50 * 1024 * 1024);
        allow update: if isMember(chatId)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            resource.data.senderId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          );
        allow delete: if resource.data.senderId == request.auth.uid;
      }

      match /typing/{userId} {
        allow read: if isMember(chatId);
        allow write: if isMember(chatId) && userId == request.auth.uid;
      }
    }

    match /calls/{callId} {
      function party() {
        return signedIn() && (
          request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId
        );
      }
      allow read: if party();
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.participantIds.hasAll([request.auth.uid, request.resource.data.calleeId])
        && request.resource.data.state == 'ringing';
      allow update: if party();
      allow delete: if false;

      match /candidates/{candidateId} {
        function callParty() {
          let call = get(/databases/$(database)/documents/calls/$(callId)).data;
          return signedIn() && (request.auth.uid == call.callerId || request.auth.uid == call.calleeId);
        }
        allow read: if callParty();
        allow create: if callParty() && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 80
        && request.resource.data.note.size() <= 500;
      allow read, update, delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn() && resource.data.expiresAt > request.time;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text.size() <= 180
        && request.resource.data.expiresAt > request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount']);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /viewers/{viewerId} {
        allow read: if signedIn();
        allow create: if signedIn() && viewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /rateLimits/{userId} {
      allow read, write: if false;
    }
  }
}
