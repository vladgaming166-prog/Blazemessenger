    <string name="logout_confirm">Te deconectezi din BlazeMessenger pe acest dispozitiv?</string>
    <string name="delete_account">Șterge contul</string>
    <string name="delete_account_body">Aceasta elimină autentificarea, profilul și numele de utilizator. Mesajele deja trimise pot rămâne în conversațiile altora, marcate ca cont șters, dacă funcția Cloud deleteAccount nu este publicată pentru curățare. Tastează numele de utilizator pentru confirmare.</string>
