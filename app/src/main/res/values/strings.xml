    <string name="onboarding_title_1">Conversations that feel close</string>
    <string name="onboarding_body_1">One-to-one chats and groups, with photos, voice notes, and files that stay between the people in the conversation.</string>
    <string name="onboarding_title_2">Calls that announce themselves</string>
    <string name="onboarding_body_2">Voice and video calls use a real ringtone, a lock-screen incoming screen where Android allows it, and a call history you can revisit.</string>
    <string name="onboarding_title_3">You decide what is visible</string>
    <string name="onboarding_body_3">Last seen, read receipts, and online status are settings, not assumptions. Block or report anyone who should not reach you.</string>

