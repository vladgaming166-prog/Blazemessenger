<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Blaze" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/blaze_paper</item>
    </style>

    <style name="Theme.Blaze.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/blaze_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_blaze_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Blaze</item>
    </style>
</resources>
